      "splitlist": "Compact application worklist beside an inspector with Details, Notes and Resume tabs.",
      "records": "Application records with inline team context and resume reference."
    },
    "plan": {
      "split": "Collapsed Job posting disclosure and CV editor beside all results; shared plan chooser and save footer.",
      "steps": "Numbered Job, Your CV and Results steps with one focused page visible at a time.",
      "document": "Document panel containing Job posting and CV fields above results.",
      "focus": "Job, Your CV and Results pages with unnumbered navigation.",
      "review": "Stacked Job posting, CV and results beside a summary; Review results scrolls and focuses the result.",
      "accordion": "Job posting, Your CV and Resume direction disclosures; CV and results start open.",
      "result-tabs": "Collapsed Job posting and CV editor beside results with Overview, Keywords and Themes tabs.",
      "workbench": "Adaptive CV/results workbench with a collapsed Job posting; currently shares split Plan markup."
    },
    "settings": {
      "rows": "Five sequential sections, each with a heading column and controls.",
      "disclosures": "Five disclosure sections; Database and Analysis start open.",
      "categories": "Local category navigation and one settings section at a time; Analysis starts selected."
