{
  "name": "pm-application-tracker",
  "version": "2.1.5",
  "private": true,
  "main": "desktop-dist/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run desktop:dev",
    "build": "npm run desktop:build",
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/job-details.test.mjs tests/job-text.test.mjs tests/public-address.test.mjs tests/desktop-store.test.mjs tests/cloud-database-safety.test.mjs tests/local-analysis.test.mjs tests/application-activity.test.mjs tests/local-models.test.mjs tests/window-shell.test.mjs tests/diagnostic-log.test.mjs tests/release-updates.test.mjs tests/analysis-cancellation.test.mjs tests/paid-analysis.test.mjs tests/guest-wallets.test.mjs tests/credits-service-ready.test.mjs tests/build-artifact-retention.test.mjs tests/local-model-response.test.mjs",
    "test:job-details": "node --experimental-strip-types --test tests/job-details.test.mjs tests/job-text.test.mjs",
    "test:credits": "node --experimental-strip-types --test tests/paid-analysis.test.mjs tests/guest-wallets.test.mjs tests/credits-service-ready.test.mjs",
    "test:renderer": "node --experimental-strip-types scripts/qa-renderer.mjs",
    "test:desktop:windows": "node scripts/qa-ember.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "credits:build": "node scripts/build-credits-service.mjs",
    "credits:start": "node credits-service/dist/server.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:prepare-model-engine": "node scripts/download-llama.mjs",
    "desktop:package:win:x64": "npm run desktop:build && electron-builder --win nsis --x64 --publish never -c electron-builder.local.cjs",
    "desktop:package:win:arm64": "npm run desktop:build && node scripts/download-electron-arm64.mjs && electron-builder --win nsis --arm64 --publish never -c electron-builder.arm64.cjs",
    "desktop:package:mac:arm64": "npm run desktop:build && electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "entities": "7.0.1",
    "htmlparser2": "10.1.0",
    "ipaddr.js": "^2.5.0",
    "lottie-web": "5.13.0",
    "lucide-react": "^1.31.0",
    "mammoth": "1.13.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "undici": "^8.11.2",
    "unpdf": "1.8.1",
    "word-extractor": "1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "jszip": "3.10.2",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "build": {
    "appId": "com.desigrit.pmapplications",
    "productName": "Zebby",
    "artifactName": "Zebby-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "desktop-packages"
    },
    "files": [
      "desktop-dist/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "icon": "build/desktop-icon.png",
    "asar": true,
    "beforePack": "scripts/prepare-llama.cjs",
    "extraResources": [
      {
        "from": "build/llama/${os}-${arch}",
        "to": "local-runtime"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/model-cleanup.nsh"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "strictVerify": true
    }
  }
}
