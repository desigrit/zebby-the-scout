{
  "name": "pm-application-tracker",
  "version": "1.4.1",
  "private": true,
  "main": "desktop-dist/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop-dist --ignore-pattern desktop-packages",
    "test": "node --experimental-strip-types --test tests/job-details.test.mjs tests/host-access.test.mjs tests/public-address.test.mjs tests/desktop-store.test.mjs tests/local-analysis.test.mjs tests/application-activity.test.mjs tests/local-models.test.mjs tests/window-shell.test.mjs tests/diagnostic-log.test.mjs",
    "test:job-details": "node --experimental-strip-types --test tests/job-details.test.mjs",
    "test:renderer": "node --experimental-strip-types scripts/qa-renderer.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:prepare-model-engine": "node scripts/download-llama.mjs",
    "desktop:package:win:x64": "npm run desktop:build && electron-builder --win nsis --x64 --publish never -c electron-builder.local.cjs",
    "desktop:package:win:arm64": "npm run desktop:build && node scripts/download-electron-arm64.mjs && electron-builder --win nsis --arm64 --publish never -c electron-builder.arm64.cjs",
    "desktop:package:mac:arm64": "npm run desktop:build && electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.31.0",
    "mammoth": "1.13.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "undici": "^8.11.2",
    "unpdf": "1.8.1",
    "vaul": "^1.1.2",
    "word-extractor": "1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "jszip": "3.10.2",
    "playwright-core": "^1.63.0",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.desigrit.pmapplications",
    "productName": "Zebby",
    "artifactName": "Zebby-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "desktop-packages"
    },
    "files": [
      "desktop-dist/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "icon": "build/desktop-icon.png",
    "asar": true,
    "beforePack": "scripts/prepare-llama.cjs",
    "extraResources": [{ "from": "build/llama/${os}-${arch}", "to": "local-runtime" }],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/model-cleanup.nsh"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
